# The public export needs no credentials. Keep the streamer controls on loopback.
HOST=127.0.0.1
PORT=3000
PUBLIC_CITY_URL=http://localhost:3000/city.html

# Twitch is optional for /dev testing. Do not put tokens in source code.
TWITCH_CLIENT_ID=
TWITCH_USER_ACCESS_TOKEN=
TWITCH_BROADCASTER_ID=
TWITCH_BOT_USER_ID=
TWITCH_EVENTSUB_URL=wss://eventsub.wss.twitch.tv/ws
TWITCH_SUBSCRIPTIONS_URL=

# Optional moderation; Codex uses its own CLI login, not this key.
OPENAI_API_KEY=
MAX_CONCURRENT_JOBS=2
MAX_BUILDS_PER_STREAM=25
BUILD_TIMEOUT_MS=180000
# Optional absolute path to Node 25+ when a host launches the app with an older Node.
VALIDATOR_NODE=
